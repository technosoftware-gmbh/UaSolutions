<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(TestsTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Technosoftware.UaUtilities.Tests</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NetStandardTests)' == 'true'">
    <DefineConstants>$(DefineConstants);NET_STANDARD_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Console" />
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Common\Main.cs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Built with LicenseTestSeam=true so that LicenseHandler exposes PublicKeyOverride.
      The fixture licences are signed with a throw-away key (Fixtures/FixtureKeys.cs);
      without the seam the handler rejects them, which is the point - none of them can
      license a shipped package. See project doc 13.
    -->
    <ProjectReference Include="..\..\..\src\Technosoftware\UaUtilities\Technosoftware.UaUtilities.csproj">
      <AdditionalProperties>LicenseTestSeam=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <!--
    Visual Studio builds each project of the solution once, in the solution configuration,
    and never builds project references itself (ResolveProjectReferences only asks them for
    GetTargetPath). The seam variant above is therefore never produced inside Visual Studio
    and csc fails with CS0006. Build it explicitly there; dotnet build / msbuild on the
    command line already build it through the ProjectReference.
    The fast up-to-date check does not see the seam output either, so a change in
    UaUtilities would otherwise leave this project on a stale seam build.
  -->
  <PropertyGroup Condition="'$(BuildingInsideVisualStudio)' == 'true'">
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <Target Name="BuildLicenseTestSeamInsideVisualStudio"
          BeforeTargets="ResolveProjectReferences"
          Condition="'$(BuildingInsideVisualStudio)' == 'true' And '$(TargetFramework)' != ''">
    <MSBuild Projects="..\..\..\src\Technosoftware\UaUtilities\Technosoftware.UaUtilities.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework);LicenseTestSeam=true" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <Content Include="Assets\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
