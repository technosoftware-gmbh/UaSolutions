<Project>
  <!--
    Imported after each project body, so $(IsPackable) here is the project's own
    value rather than the `false` default from common.props. The same reference in
    common.props would never match: Directory.Build.props is evaluated before the
    csproj sets IsPackable.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>
</Project>
