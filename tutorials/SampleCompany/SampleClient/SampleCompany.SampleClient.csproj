<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <AssemblyName>SampleCompany.SampleClient</AssemblyName>
    <OutputType>Exe</OutputType>
    <PackageId>SampleCompany.SampleClient</PackageId>
    <RootNamespace>SampleCompany.SampleClient</RootNamespace>
    <Company>SampleCompany</Company>
    <Product>SampleCompany SampleClient</Product>
    <Description>SampleCompany SampleClient</Description>
    <Copyright>Copyright © 2018 - 2026 SampleCompany</Copyright>
  </PropertyGroup>
  <!--
    TEMPORARY, for the OPC Foundation 2.0 migration only.
    These tutorials normally consume the published Technosoftware.UaSolutions.*
    packages, which is the point of the "Sample" flavour. There is no 7.0
    package yet, and the 6.x ones bring the 1.5 stack with them, so on this
    branch they would mix stack versions and fail to bind at all. Project
    references let the sample sources be migrated and verified in the
    meantime; restore the PackageReferences before merging.
  -->
  <ItemGroup>
    <Compile
      Include="..\Common\ConsoleUtils.cs"
      Exclude="bin\**;obj\**;**\*.xproj;packages\**"
    />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Mono.Options" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Expressions" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Debug" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Types" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Security.Certificates" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Core" />
    <PackageReference Include="Newtonsoft.Json" />
    <ProjectReference Include="..\..\..\src\Technosoftware\UaUtilities\Technosoftware.UaUtilities.csproj" />
    <ProjectReference Include="..\..\..\src\Technosoftware\UaConfiguration\Technosoftware.UaConfiguration.csproj" />
    <ProjectReference Include="..\..\..\src\Technosoftware\UaClient\Technosoftware.UaClient.csproj" />	
  </ItemGroup>     
  <ItemGroup>
    <None Update="SampleCompany.SampleClient.Config.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>